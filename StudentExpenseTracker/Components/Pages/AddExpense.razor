@page "/add"
@rendermode InteractiveServer
@inject ExpenseService ExpenseService
@inject NavigationManager Navigation

<div class="card card-onyx shadow-lg p-4">
    <h3 class="fw-bold mb-4" style="color: var(--accent-yellow);">Add New Expense</h3>

    <EditForm Model="expense" OnValidSubmit="HandleSubmit" FormName="AddExpenseForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" />

        <div class="mb-3">
            <label class="form-label text-light fw-semibold">Expense Title</label>
            <InputText class="form-control form-control-onyx" @bind-Value="expense.Title" placeholder="e.g. Textbooks" />
        </div>

        <div class="mb-3">
            <label class="form-label text-light fw-semibold">Description</label>
            <InputText class="form-control form-control-onyx" @bind-Value="expense.Description" placeholder="Optional details..." />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-light fw-semibold">Amount (₱)</label>
                <InputNumber class="form-control form-control-onyx" @bind-Value="expense.Amount" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label text-light fw-semibold">Category</label>
                <InputSelect class="form-select form-control-onyx" @bind-Value="expense.Category">
                    <option value="">Select Category</option>
                    <option value="Food">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="School Supplies">School Supplies</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Other">Other</option>
                </InputSelect>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-light fw-semibold">Date</label>
            <InputDate class="form-control form-control-onyx" @bind-Value="expense.Date" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-yellow px-4 py-2">Save Expense</button>
            <a href="expenses" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    private Expense expense = new Expense { Date = DateTime.Today };

    private void HandleSubmit()
    {
        ExpenseService.AddExpense(expense);
        Navigation.NavigateTo("expenses");
    }
}