@page "/register"
@layout StudentExpenseTracker.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Components

<PageTitle>Register - Gasto Buster</PageTitle>

<div class="app-container min-vh-100 d-flex align-items-center justify-content-center position-relative text-light p-4">
    <main style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <div class="fw-bold fs-3 text-warning tracking-wide mb-1">GASTO BUSTER</div>
            <p class="text-accent-blue small m-0">Create Your Account</p>
        </div>

        <div class="glass-card p-4 p-md-5 shadow-xl">
            <div class="mb-4">
                <h3 class="fw-bold m-0 text-white fs-4">Sign Up</h3>
                <p class="text-muted small m-0 mt-1">Start tracking your expenses today</p>
            </div>

            <form method="post" action="/account/register">
                <div class="mb-4">
                    <label class="minimal-label" for="Email">EMAIL</label>
                    <input id="Email" name="Email" type="email" class="form-control minimal-input" placeholder="e.g. student@act.edu.ph" />
                </div>

                <div class="mb-4">
                    <label class="minimal-label" for="Password">PASSWORD</label>
                    <input id="Password" name="Password" type="password" class="form-control minimal-input" placeholder="At least 8 characters" />
                </div>

                <div class="mb-4">
                    <label class="minimal-label" for="ConfirmPassword">CONFIRM PASSWORD</label>
                    <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control minimal-input" placeholder="Re-enter your password" />
                </div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger py-2 small mb-3">@Error</div>
                }

                <button type="submit" class="btn-primary-modern w-100 py-3 mb-3">Create Account</button>
            </form>

            <div class="text-center">
                <a href="/login" class="text-accent-blue small text-decoration-none">Already have an account? Sign in</a>
            </div>
        </div>
    </main>
</div>

<style>
    body, .app-container {
        background-color: #000000 !important;
        color: #f1f5f9 !important;
        font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
    }

    .tracking-wide {
        letter-spacing: 0.1em;
    }

    .glass-card {
        background: linear-gradient(145deg, #131316 0%, #0d0d0f 100%) !important;
        border: 1px solid rgba(255, 255, 255, 0.09) !important;
        border-radius: 18px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .text-accent-blue {
        color: #38bdf8 !important;
    }

    .minimal-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: #94a3b8;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        display: block;
    }

    .minimal-input {
        background-color: #08080a !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 0.9rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .minimal-input:focus {
            border-color: #ffc107 !important;
            box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.15), inset 0 1px 1px rgba(0,0,0,0.5) !important;
            background-color: #0c0c0e !important;
            outline: none;
        }

    .btn-primary-modern {
        background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
        color: #000000;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        text-align: center;
        transition: all 0.2s ease;
        box-shadow: 0 4px 20px rgba(255, 193, 7, 0.25);
    }

        .btn-primary-modern:hover {
            background: linear-gradient(135deg, #ffca2c 0%, #ffc107 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(255, 193, 7, 0.4);
        }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}