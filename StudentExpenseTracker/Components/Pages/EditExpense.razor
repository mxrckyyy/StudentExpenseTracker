@page "/edit/{id:int}"
@rendermode InteractiveServer
@inject ExpenseService ExpenseService
@inject NavigationManager Navigation

<div class="card card-onyx shadow-lg p-4">
    <h3 class="fw-bold mb-4" style="color: var(--accent-yellow);">Edit Expense</h3>

    @if (expense == null)
    {
        <p class="text-muted"><em>Loading expense details...</em></p>
    }
    else
    {
        <EditForm Model="expense" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator /> 
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label text-light fw-semibold">Expense Title</label>
                <InputText class="form-control form-control-onyx" @bind-Value="expense.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label text-light fw-semibold">Description</label>
                <InputText class="form-control form-control-onyx" @bind-Value="expense.Description" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label text-light fw-semibold">Amount (₱)</label>
                    <InputNumber class="form-control form-control-onyx" @bind-Value="expense.Amount" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-light fw-semibold">Category</label>
                    <InputSelect class="form-select form-control-onyx" @bind-Value="expense.Category">
                        <option value="">Select Category</option>
                        <option value="Food">Food</option>
                        <option value="Transport">Transport</option>
                        <option value="School Supplies">School Supplies</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-light fw-semibold">Date</label>
                <InputDate class="form-control form-control-onyx" @bind-Value="expense.Date" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-yellow px-4 py-2">Save Changes</button>
                <a href="expenses" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Expense? expense;

    protected override void OnInitialized()
    {
        var existing = ExpenseService.GetExpenseById(Id);
        if (existing != null)
        {
            expense = new Expense
            {
                Id = existing.Id,
                Title = existing.Title,
                Description = existing.Description,
                Amount = existing.Amount,
                Category = existing.Category,
                Date = existing.Date
            };
        }
        else
        {
            Navigation.NavigateTo("expenses");
        }
    }

    private void HandleSubmit()
    {
        if (expense != null)
        {
            ExpenseService.UpdateExpense(expense);
            Navigation.NavigateTo("expenses");
        }
    }
}