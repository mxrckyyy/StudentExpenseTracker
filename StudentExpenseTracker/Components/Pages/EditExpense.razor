@page "/edit/{id:int}"
@rendermode InteractiveServer
@inject ExpenseService ExpenseService
@inject NavigationManager Navigation

<div class="card shadow-sm border-0 mt-3">
    <div class="card-body p-4">
        <h3 class="card-title mb-4">Edit Expense</h3>

        @if (expense == null)
        {
            <p><em>Loading expense details...</em></p>
        }
        else
        {
            <EditForm Model="expense" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">Title</label>
                    <InputText id="title" class="form-control" @bind-Value="expense.Title" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">Description</label>
                    <InputText id="description" class="form-control" @bind-Value="expense.Description" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="amount" class="form-label fw-semibold">Amount (₱)</label>
                        <InputNumber id="amount" class="form-control" @bind-Value="expense.Amount" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="category" class="form-label fw-semibold">Category</label>
                        <InputSelect id="category" class="form-select" @bind-Value="expense.Category">
                            <option value="">Select Category</option>
                            <option value="Food">Food</option>
                            <option value="Transport">Transport</option>
                            <option value="School Supplies">School Supplies</option>
                            <option value="Entertainment">Entertainment</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="date" class="form-label fw-semibold">Date</label>
                    <InputDate id="date" class="form-control" @bind-Value="expense.Date" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    <a href="expenses" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Expense? expense;

    protected override void OnInitialized()
    {
        var existing = ExpenseService.GetExpenseById(Id);
        if (existing != null)
        {
            expense = new Expense
            {
                Id = existing.Id,
                Title = existing.Title,
                Description = existing.Description,
                Amount = existing.Amount,
                Category = existing.Category,
                Date = existing.Date
            };
        }
        else
        {
            Navigation.NavigateTo("expenses");
        }
    }

    private void HandleSubmit()
    {
        if (expense != null)
        {
            ExpenseService.UpdateExpense(expense);
            Navigation.NavigateTo("expenses");
        }
    }
}