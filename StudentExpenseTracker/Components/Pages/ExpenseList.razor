@page "/expenses"
@rendermode InteractiveServer
@inject ExpenseService ExpenseService
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0" style="color: var(--accent-yellow);">All Expenses</h3>
    <a href="add" class="btn btn-yellow px-3 py-2">+ Add New Expense</a>
</div>

<div class="card card-onyx shadow-lg overflow-hidden">
    <div class="table-responsive">
        <table class="table table-onyx m-0">
            <thead>
                <tr>
                    <th>Expense Title</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (expenses == null || !expenses.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No expenses found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in expenses)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td style="color: #e2e8f0; font-size: 0.95rem;">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>
                            <td><span class="badge bg-dark border border-secondary text-light">@item.Category</span></td>
                            <td class="fw-bold" style="color: var(--accent-yellow);">₱@item.Amount.ToString("N2")</td>
                            <td class="text-muted">@item.Date.ToShortDateString()</td>
                            <td class="text-end">
                                <a href="edit/@item.Id" class="btn btn-sm btn-yellow me-1">Edit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExpense(item.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Expense> expenses = new();

    protected override void OnInitialized()
    {
        expenses = ExpenseService.GetExpenses();
    }

    private void DeleteExpense(int id)
    {
        ExpenseService.DeleteExpense(id);
        expenses = ExpenseService.GetExpenses();
    }
}